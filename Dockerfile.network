# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:1.85-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY aeth-network  ./aeth-network
COPY aeth-prover   ./aeth-prover
COPY aeth-simulator ./aeth-simulator

RUN cargo build --release -p aeth-network

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/aeth-network /usr/local/bin/aeth-network

EXPOSE 4001/tcp 4001/udp 8080/tcp

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/aeth-network"]
CMD ["--role", "full", "--port", "4001", "--metrics-port", "8080"]
