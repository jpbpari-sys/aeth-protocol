FROM rust:1.85-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY aeth-cache     ./aeth-cache
COPY aeth-network   ./aeth-network
COPY aeth-prover    ./aeth-prover
COPY aeth-simulator ./aeth-simulator
RUN cargo build --release -p aeth-simulator

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/aeth-simulator /usr/local/bin/aeth-simulator
ENTRYPOINT ["/usr/local/bin/aeth-simulator"]
CMD ["--nodes", "50", "--byzantine", "0.25", "--rounds", "500"]
