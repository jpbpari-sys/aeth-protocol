# NODE_ROLE: validator | sequencer | prover | full
NODE_ROLE=full

# Stake amount (in AETH base units)
STAKE_AMOUNT=100000

# libp2p listen port
LISTEN_PORT=4001

# Prometheus metrics port
METRICS_PORT=8080

# Comma-separated bootnode multiaddrs
# BOOTNODES=/ip4/34.X.X.X/tcp/4001/p2p/QmXXX

# Rust log filter
RUST_LOG=info,aeth_network=debug,aeth_prover=debug

# Prover workers
PROVER_WORKERS=8

# GPU device ID (0 = first GPU; ignored if no CUDA support compiled)
GPU_ID=0

# Solana devnet RPC (for Anchor program interaction)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ID — update after anchor deploy
PROGRAM_ID=AethRollup111111111111111111111111111111111
